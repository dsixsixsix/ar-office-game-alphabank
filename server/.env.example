# Copy to .env and replace every value. .env is ignored by git.
POSTGRES_PASSWORD=change-me-postgres
# Server key is sent by every client (game and admin panel), so it is not a secret, but it must match
# office_game/server/key in client/project.godot and VITE_NAKAMA_SERVER_KEY in admin/.env.
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_HTTP_KEY=change-me-http-key
NAKAMA_SESSION_KEY=change-me-session-key
NAKAMA_REFRESH_KEY=change-me-refresh-key
NAKAMA_CONSOLE_PASSWORD=change-me-console
# Admin panel account, created or updated on every server start. Password: 8+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# Signs the office entry and exit QR codes. 16+ characters, only the server knows it.
PRESENCE_SECRET=change-me-presence-secret
# true only on a developer machine: dev RPCs (debug keys, emulator codes, tour) and the dev clock.
DEV_MODE=false
